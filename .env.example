# PostgreSQL
FAIRDROP_DB_URL=jdbc:postgresql://HOST:5432/DATABASE
FAIRDROP_DB_USERNAME=USERNAME
FAIRDROP_DB_PASSWORD=PASSWORD
FAIRDROP_DB_POOL_SIZE=10

# Redis / Valkey
FAIRDROP_REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# Kafka / Redpanda
FAIRDROP_KAFKA_BOOTSTRAP_SERVERS=HOST:PORT
FAIRDROP_KAFKA_SECURITY_PROTOCOL=SASL_SSL
FAIRDROP_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
FAIRDROP_KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="USERNAME" password="PASSWORD";
FAIRDROP_KAFKA_AUTO_CREATE_TOPICS=false

# Runtime
SPRING_PROFILES_ACTIVE=prod
PORT=8080
